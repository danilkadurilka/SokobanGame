<Window x:Class="SokobanGame.Views.RecordsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SokobanGame.Views"
        mc:Ignorable="d"
        Height="500" Width="600"
        WindowStartupLocation="CenterScreen"
        Background="Purple"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True">
    <Border Background="Purple">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Background="#6A3E6B" Height="80">
                <Grid>
                    <TextBlock Text="Рекорды🏆" FontSize="28" FontWeight="Bold" 
                               Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0 0 15 0">
                        <Button Click="BackToMenu_Click" Background="Transparent" BorderBrush="Transparent">
                            <Image Source="/Images/close.png" Width="40" Height="40"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <ItemsControl Name="RecordsListBox" Margin="20">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#4A2B5A" CornerRadius="10" Margin="0 0 0 15" Padding="15">
                                <StackPanel>
                                    <TextBlock Text="{Binding LevelName}" FontSize="20" FontWeight="Bold" 
                                               Foreground="#FFD966" Margin="0 0 0 10"/>
                                    <Border Background="#3D2B4D" CornerRadius="5" Padding="10" Margin="0 0 0 5">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2*"/>
                                                <ColumnDefinition Width="1*"/>
                                                <ColumnDefinition Width="1*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Игрок" Foreground="#FFD966" FontWeight="Bold"/>
                                            <TextBlock Grid.Column="1" Text="Ходов" Foreground="#FFD966" FontWeight="Bold" HorizontalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Text="Время" Foreground="#FFD966" FontWeight="Bold" HorizontalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                    <ItemsControl ItemsSource="{Binding Records}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Padding="10 5" Margin="0 1">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="2*"/>
                                                            <ColumnDefinition Width="1*"/>
                                                            <ColumnDefinition Width="1*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="{Binding PlayerName}" Foreground="White" FontSize="14"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding MovesText}" Foreground="White" FontSize="14" 
                                                                   HorizontalAlignment="Center"/>
                                                        <TextBlock Grid.Column="2" Text="{Binding TimeText}" Foreground="White" FontSize="14" 
                                                                   HorizontalAlignment="Center"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <Border Grid.Row="2" Background="#6A3E6B" Height="70">
                <Button Content="← Вернуться в меню" Background="#9B4D96" Foreground="White" 
                        FontSize="16" Padding="15 8" BorderThickness="0" HorizontalAlignment="Center" 
                        VerticalAlignment="Center" Click="BackToMenu_Click"/>
            </Border>
        </Grid>
    </Border>
</Window>