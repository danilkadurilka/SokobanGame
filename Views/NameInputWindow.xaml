<Window x:Class="SokobanGame.Views.NameInputWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SokobanGame.Views"
        mc:Ignorable="d"
        Height="250" Width="350"
        Background="Purple"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#9B4D96"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border Background="Purple">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Background="#6A3E6B" Height="50">
                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0 0 15 0">
                    <Button Click="CloseWindow_Click" Background="Transparent" BorderBrush="Transparent">
                        <Image Source="/Images/close.png" Width="40" Height="40"/>
                    </Button>
                </StackPanel>
            </Border>
            <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Width="300">
                <TextBlock Text="Введите ваше имя" FontSize="24" FontWeight="Bold"
                           Foreground="White" HorizontalAlignment="Center" Margin="0 0 0 20"/>
                <TextBox Name="PlayerNameTextBox"
                         FontSize="18" Padding="10" Background="#4A2B5A"
                         Foreground="White" BorderThickness="0" Margin="0 0 0 20"/>
                <Button Content="Продолжить" FontSize="18" Padding="20 10" Click="NextStage_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
